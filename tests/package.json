{
  "name": "musdb-web-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Read-only browser regression tests for the public μ's Song Database web UI",
  "scripts": {
    "test:ui-links": "node --test ui-link-consistency.test.cjs home-recent-singer-links.test.cjs",
    "test:gap-rankings": "node --test gap-rankings.test.cjs gap-rankings-ui.test.cjs",
    "test:release-today-songs": "node --test release-today-songs.test.cjs",
    "test:api-jsonp": "node --test api-jsonp-timeout.test.cjs api-jsonp-collision.test.cjs api-cache-cleanup.test.cjs",
    "test:statistics": "node --test statistics-progressive-render.test.cjs",
    "contract:search": "node --test search-api-contract.test.cjs",
    "e2e:search-release": "node --test search-release-ui.test.cjs search-latest-response.test.cjs",
    "e2e:home-today-release": "node --test home-today-release.test.cjs",
    "e2e:navigation": "node --test common-navigation.test.cjs",
    "e2e:release": "node --test release-list.test.cjs",
    "e2e:release-detail": "node --test release-detail.test.cjs release-kamipara-content-preservation.test.cjs",
    "e2e:song-release": "node --test song-release-link.test.cjs",
    "e2e:event-release": "node --test event-related-releases-ui.test.cjs",
    "test:detail-initial-render": "node --test detail-initial-render.test.cjs",
    "test:detail-snapshot": "node --test detail-snapshot.test.cjs",
    "test:static-html-validator": "node --test static-html-validator.test.cjs",
    "test:capture-provenance": "node --test capture-provenance.test.cjs",
    "test:capture-provenance:integration": "node -e \"process.env.MUSDB_CAPTURE_PROVENANCE_INTEGRATION='1';require('node:child_process').execFileSync(process.execPath,['--test','capture-provenance.test.cjs'],{stdio:'inherit',env:process.env})\"",
    "test:static-detail-ui": "node --test static-detail-ui.test.cjs",
    "test:seo-indexing": "node --test seo-indexing.test.cjs",
    "sitemap:check": "node ../tools/generate-sitemap.cjs --check",
    "e2e": "node --test web-e2e.test.cjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
